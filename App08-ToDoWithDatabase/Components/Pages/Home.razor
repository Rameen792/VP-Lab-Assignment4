@page "/"

<PageTitle>Home</PageTitle>

<div class="hero-section">

    <div style="position:relative; z-index:1;">

        <div class="hero-badge">
            APP 08
        </div>

        <h1>
            ToDo Database Manager
        </h1>

        <p>
            Task management system using
            Blazor, Entity Framework Core
            and Railway PostgreSQL.
        </p>

    </div>

</div>

<div class="row g-4">

    <div class="col-md-4">

        <div class="feature-card">

            <h4>Database Storage</h4>

            <p>
                Tasks are permanently saved
                inside PostgreSQL.
            </p>

        </div>

    </div>

    <div class="col-md-4">

        <div class="feature-card">

            <h4>Task Management</h4>

            <p>
                Create, edit, delete
                and organize tasks.
            </p>

        </div>

    </div>

    <div class="col-md-4">

        <div class="feature-card">

            <h4>Modern UI</h4>

            <p>
                Responsive design
                with dashboard layout.
            </p>

        </div>

    </div>

</div>