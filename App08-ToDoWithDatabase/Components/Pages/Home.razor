@page "/"

<PageTitle>TaskVault — Home</PageTitle>

<div class="v-hero">
    <div class="v-tag">✦ Application 08</div>
    <h1 class="v-title">ToDo App with<br />PostgreSQL Database</h1>
    <p class="v-sub">
        Full CRUD task manager backed by a cloud PostgreSQL database on Neon.
        Every create, update, delete and toggle is persisted in real time.
    </p>
    <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:1.5rem;">
        <a href="/todos" class="btn-v" style="text-decoration:none;">✅ Open Task Manager</a>
    </div>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:1rem; margin-bottom:1.5rem;">
    <div class="v-card">
        <div style="font-size:1.5rem; margin-bottom:0.6rem;">🐘</div>
        <div style="font-weight:700; font-size:0.9rem; margin-bottom:0.35rem; color:var(--text-1);">PostgreSQL on Neon</div>
        <div style="color:var(--text-2); font-size:0.83rem; line-height:1.55;">Cloud-hosted Postgres via Neon.tech. Free tier. Full SQL with auto-SSL.</div>
    </div>
    <div class="v-card">
        <div style="font-size:1.5rem; margin-bottom:0.6rem;">⚡</div>
        <div style="font-weight:700; font-size:0.9rem; margin-bottom:0.35rem; color:var(--text-1);">EF Core + Npgsql</div>
        <div style="color:var(--text-2); font-size:0.83rem; line-height:1.55;">Entity Framework Core with Npgsql provider. Strongly typed models, no raw SQL needed.</div>
    </div>
    <div class="v-card">
        <div style="font-size:1.5rem; margin-bottom:0.6rem;">🔄</div>
        <div style="font-weight:700; font-size:0.9rem; margin-bottom:0.35rem; color:var(--text-1);">Full CRUD</div>
        <div style="color:var(--text-2); font-size:0.83rem; line-height:1.55;">Create, Read, Update (edit title + toggle complete), and Delete — all synced to DB.</div>
    </div>
    <div class="v-card">
        <div style="font-size:1.5rem; margin-bottom:0.6rem;">🏷️</div>
        <div style="font-weight:700; font-size:0.9rem; margin-bottom:0.35rem; color:var(--text-1);">Priority Levels</div>
        <div style="color:var(--text-2); font-size:0.83rem; line-height:1.55;">Tag each task as High / Medium / Low priority. Stored and displayed with colour-coded badges.</div>
    </div>
</div>

<div class="v-card" style="background:rgba(130,100,255,0.06); border-color:rgba(130,100,255,0.2);">
    <h6 style="font-weight:700; color:var(--violet-light); margin-bottom:0.5rem;">🛠️ Stack</h6>
    <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
        @foreach (var t in new[] { "Blazor Server", ".NET 10", "EF Core", "Npgsql", "PostgreSQL", "Neon.tech" })
        {
            <span style="background:var(--elevated); border:1px solid var(--border); color:var(--text-2); padding:0.3rem 0.7rem; border-radius:8px; font-size:0.78rem; font-weight:500;">@t</span>
        }
    </div>
</div>