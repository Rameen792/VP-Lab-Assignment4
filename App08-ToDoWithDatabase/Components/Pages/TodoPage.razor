@page "/todos"
@rendermode InteractiveServer
@inject App08_ToDoWithDatabase.Services.TodoService TodoService

<PageTitle>My Tasks — TaskVault</PageTitle>

<!-- Hero -->
<div class="v-hero" style="padding:1.5rem 2rem; margin-bottom:1.25rem;">
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
        <div>
            <div class="v-tag">✅ Task Manager</div>
            <h2 class="v-title" style="font-size:1.4rem; margin-bottom:0.25rem;">My Tasks</h2>
            <p style="color:var(--text-2); font-size:0.85rem;">Synced with PostgreSQL · Every action persists instantly</p>
        </div>
        <button class="btn-ghost" @onclick="LoadTasks" disabled="@_loading">🔄 Refresh</button>
    </div>
</div>

<!-- Stats -->
@if (_stats.Total >= 0)
{
    <div class="stat-bar">
        <div class="stat-item">
            <div class="stat-number" style="color:var(--violet-light);">@_stats.Total</div>
            <div class="stat-label">Total Tasks</div>
        </div>
        <div class="stat-item">
            <div class="stat-number" style="color:var(--green);">@_stats.Completed</div>
            <div class="stat-label">Completed</div>
        </div>
        <div class="stat-item">
            <div class="stat-number" style="color:var(--amber);">@_stats.Pending</div>
            <div class="stat-label">Pending</div>
        </div>
        @if (_stats.Total > 0)
        {
            <div class="stat-item">
                <div class="stat-number" style="color:var(--text-1);">@((_stats.Completed * 100 / _stats.Total))%</div>
                <div class="stat-label">Done</div>
            </div>
        }
    </div>
}

<!-- Add Task Form -->
<div class="v-card" style="margin-bottom:1.25rem;">
    <h6 style="font-weight:700; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-2); margin-bottom:1rem;">➕ Add New Task</h6>
    <div style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:flex-end;">
        <div style="flex:1; min-width:220px;">
            <input class="v-input"
                   placeholder="What needs to be done?"
                   @bind="_newTitle"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown" />
        </div>
        <div style="min-width:160px;">
            <select class="v-input" @bind="_newPriority">
                <option value="High">🔴 High Priority</option>
                <option value="Medium" selected>🟡 Medium Priority</option>
                <option value="Low">🟢 Low Priority</option>
            </select>
        </div>
        <button class="btn-v" @onclick="AddTask" disabled="@(string.IsNullOrWhiteSpace(_newTitle) || _loading)">
            ➕ Add Task
        </button>
    </div>
    @if (!string.IsNullOrEmpty(_errorMsg))
    {
        <div style="margin-top:0.75rem; color:var(--red); font-size:0.83rem;">⚠️ @_errorMsg</div>
    }
</div>

<!-- Task List -->
@if (_loading)
{
    <div style="text-align:center; padding:3rem;">
        <div class="v-spinner"></div>
        <div style="color:var(--text-3); font-size:0.875rem; margin-top:0.5rem;">Loading from database…</div>
    </div>
}
else if (_tasks.Count == 0)
{
    <div class="v-card" style="text-align:center; padding:3rem; color:var(--text-3);">
        <div style="font-size:2.5rem; margin-bottom:0.75rem;">📭</div>
        <div style="font-weight:600; margin-bottom:0.35rem; color:var(--text-2);">No tasks yet</div>
        <div style="font-size:0.85rem;">Add your first task above to get started.</div>
    </div>
}
else
{
    @foreach (var task in _tasks)
    {
        <div class="todo-item @(task.IsCompleted ? "done" : "")">
            <!-- Checkbox -->
            <div class="todo-check @(task.IsCompleted ? "checked" : "")"
                 @onclick="() => ToggleTask(task.Id)"
                 title="@(task.IsCompleted ? "Mark incomplete" : "Mark complete")">
                @if (task.IsCompleted)
                {
                    <span style="color:white; font-size:0.7rem;">✓</span>
                }
            </div>

            <!-- Title (or edit input) -->
            <div style="flex:1;">
                @if (_editingId == task.Id)
                {
                    <input class="v-input" style="padding:0.4rem 0.75rem; font-size:0.875rem;"
                           @bind="_editTitle"
                           @bind:event="oninput"
                           @onkeydown="HandleEditKeyDown" />
                }
                else
                {
                    <div class="todo-title @(task.IsCompleted ? "done" : "")">@task.Title</div>
                    <div class="todo-meta">
                        @task.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")
                    </div>
                }
            </div>

            <!-- Priority badge -->
            <span class="prio-badge prio-@task.Priority.ToLower()">@task.Priority</span>

            <!-- Action buttons -->
            @if (_editingId == task.Id)
            {
                <button class="btn-success-ghost" @onclick="() => SaveEdit(task.Id)">💾 Save</button>
                <button class="btn-ghost" @onclick="CancelEdit">✕</button>
            }
            else
            {
                <button class="btn-ghost" @onclick="() => StartEdit(task)">✏️</button>
                <button class="btn-danger-ghost" @onclick="() => DeleteTask(task.Id)">🗑️</button>
            }
        </div>
    }
}

@code {
    private List<App08_ToDoWithDatabase.Models.TodoTask> _tasks = new();
    private (int Total, int Completed, int Pending) _stats = (0, 0, 0);
    private bool _loading = false;
    private string _newTitle = "";
    private string _newPriority = "Medium";
    private string _errorMsg = "";

    private int? _editingId = null;
    private string _editTitle = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        _loading = true;
        _errorMsg = "";
        try
        {
            _tasks = await TodoService.GetAllAsync();
            _stats = await TodoService.GetStatsAsync();
        }
        catch (Exception ex)
        {
            _errorMsg = $"Failed to load: {ex.Message}";
        }
        finally { _loading = false; }
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(_newTitle)) return;
        _errorMsg = "";
        try
        {
            await TodoService.CreateAsync(_newTitle, _newPriority);
            _newTitle = "";
            _newPriority = "Medium";
            await LoadTasks();
        }
        catch (Exception ex) { _errorMsg = $"Error: {ex.Message}"; }
    }

    private async Task ToggleTask(int id)
    {
        await TodoService.ToggleCompleteAsync(id);
        await LoadTasks();
    }

    private async Task DeleteTask(int id)
    {
        await TodoService.DeleteAsync(id);
        await LoadTasks();
    }

    private void StartEdit(App08_ToDoWithDatabase.Models.TodoTask task)
    {
        _editingId = task.Id;
        _editTitle = task.Title;
    }

    private async Task SaveEdit(int id)
    {
        if (!string.IsNullOrWhiteSpace(_editTitle))
        {
            await TodoService.UpdateTitleAsync(id, _editTitle);
            await LoadTasks();
        }
        CancelEdit();
    }

    private void CancelEdit() { _editingId = null; _editTitle = ""; }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTask();
    }

    private async Task HandleEditKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _editingId.HasValue) await SaveEdit(_editingId.Value);
        if (e.Key == "Escape") CancelEdit();
    }
}