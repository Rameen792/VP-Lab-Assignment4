@page "/theme-demo"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Theme Demo — ThemeSwitch</PageTitle>

<div style="margin-bottom:1.5rem;">
    <div class="hero-eyebrow">🎨 Live Demo</div>
    <h2 style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">
        Theme Palette Preview
    </h2>
    <p style="color:var(--text-secondary);">Click a palette below to switch the theme live.</p>
</div>

<!-- Clickable Theme Palettes -->
<div class="card-surface" style="margin-bottom:1.25rem;">
    <h5 style="font-weight:700; margin-bottom:1rem; color:var(--text-primary);">🎨 Active Palette</h5>
    <p style="font-size:0.8rem; color:var(--text-muted); margin-bottom:1rem;">Click any palette to apply it instantly.</p>

    <div style="display:flex; gap:1rem; flex-wrap:wrap;">

        <!-- Light palette -->
        <div @onclick='() => ApplyTheme("light")'
             style="cursor:pointer; border-radius:14px; border: 2px solid @(_currentTheme == "light" ? "var(--accent)" : "var(--border)");
                    padding:0.75rem; transition:all 0.2s; background:var(--bg-elevated);">
            <div style="display:flex; gap:6px; margin-bottom:0.5rem;">
                <div style="width:28px;height:28px;border-radius:8px;background:#f5f0e8;border:1px solid rgba(0,0,0,0.1);"></div>
                <div style="width:28px;height:28px;border-radius:8px;background:#fdfaf4;border:1px solid rgba(0,0,0,0.1);"></div>
                <div style="width:28px;height:28px;border-radius:8px;background:#c8621a;border:1px solid rgba(0,0,0,0.1);"></div>
                <div style="width:28px;height:28px;border-radius:8px;background:#1a1612;border:1px solid rgba(0,0,0,0.1);"></div>
            </div>
            <div style="font-size:0.78rem; font-weight:600; color:var(--text-primary);">☀️ Light</div>
            @if (_currentTheme == "light")
            {
                <div style="font-size:0.7rem; color:var(--accent); margin-top:2px;">● Active</div>
            }
        </div>

        <!-- Dark palette -->
        <div @onclick='() => ApplyTheme("dark")'
             style="cursor:pointer; border-radius:14px; border: 2px solid @(_currentTheme == "dark" ? "var(--accent)" : "var(--border)");
                    padding:0.75rem; transition:all 0.2s; background:var(--bg-elevated);">
            <div style="display:flex; gap:6px; margin-bottom:0.5rem;">
                <div style="width:28px;height:28px;border-radius:8px;background:#111318;border:1px solid rgba(255,255,255,0.1);"></div>
                <div style="width:28px;height:28px;border-radius:8px;background:#1e2129;border:1px solid rgba(255,255,255,0.1);"></div>
                <div style="width:28px;height:28px;border-radius:8px;background:#f0b429;border:1px solid rgba(255,255,255,0.1);"></div>
                <div style="width:28px;height:28px;border-radius:8px;background:#eceef4;border:1px solid rgba(255,255,255,0.1);"></div>
            </div>
            <div style="font-size:0.78rem; font-weight:600; color:var(--text-primary);">🌙 Dark</div>
            @if (_currentTheme == "dark")
            {
                <div style="font-size:0.7rem; color:var(--accent); margin-top:2px;">● Active</div>
            }
        </div>

    </div>
</div>

<!-- Typography showcase -->
<div class="card-surface" style="margin-bottom:1.25rem;">
    <h5 style="font-weight:700; margin-bottom:1rem; color:var(--text-primary);">✍️ Typography</h5>
    <p style="font-family:'Playfair Display',serif; font-size:1.5rem; color:var(--text-primary); margin-bottom:0.5rem;">
        Display Heading — Playfair Display
    </p>
    <p style="color:var(--text-primary); margin-bottom:0.25rem;">Body text — DM Sans Regular</p>
    <p style="color:var(--text-secondary); margin-bottom:0.25rem;">Secondary text — DM Sans</p>
    <p style="color:var(--text-muted); font-size:0.875rem;">Muted text — DM Sans Small</p>
    <p style="color:var(--accent); font-weight:600; margin-top:0.5rem;">Accent coloured text</p>
</div>

<!-- Buttons and inputs showcase -->
<div class="card-surface" style="margin-bottom:1.25rem;">
    <h5 style="font-weight:700; margin-bottom:1rem; color:var(--text-primary);">🖱️ Interactive Elements</h5>
    <div style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center; margin-bottom:1rem;">
        <button class="btn-accent">Primary Action</button>
        <button style="background:transparent; border:1.5px solid var(--accent); color:var(--accent); padding:0.6rem 1.4rem; border-radius:10px; font-weight:600; cursor:pointer; font-family:'DM Sans',sans-serif; transition:all 0.2s;">
            Outline Button
        </button>
    </div>
    <input style="background:var(--bg-secondary); border:1px solid var(--border); color:var(--text-primary); padding:0.6rem 1rem; border-radius:10px; font-family:'DM Sans',sans-serif; width:100%; max-width:300px; outline:none; transition:all 0.2s;"
           placeholder="Sample input field" />
</div>

<!-- LocalStorage readout -->
<div class="card-surface">
    <h5 style="font-weight:700; margin-bottom:0.75rem; color:var(--text-primary);">💾 localStorage Value</h5>
    <p style="color:var(--text-secondary); font-size:0.875rem; margin-bottom:0.75rem;">
        The key <code style="color:var(--accent)">theme</code> is read on load and written on toggle.
        Current saved value:
    </p>
    <div style="background:var(--bg-secondary); border:1px solid var(--border); padding:0.75rem 1rem; border-radius:10px; font-family:monospace; color:var(--accent); font-size:0.9rem;">
        localStorage['theme'] = "@_savedTheme"
    </div>
</div>

@code {
    private string _savedTheme = "loading...";
    private string _currentTheme = "dark"; // mirrors what's on body

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "theme") ?? "dark";
            _savedTheme = saved;
            _currentTheme = saved;
            StateHasChanged();
        }
    }

    private async Task ApplyTheme(string theme)
    {
        _currentTheme = theme;
        _savedTheme = theme;

        var add = theme == "dark" ? "dark-mode" : "light-mode";
        var remove = theme == "dark" ? "light-mode" : "dark-mode";

        await JS.InvokeVoidAsync("themeSwitch", add, remove);
        await JS.InvokeVoidAsync("localStorage.setItem", "theme", theme);
    }
}
