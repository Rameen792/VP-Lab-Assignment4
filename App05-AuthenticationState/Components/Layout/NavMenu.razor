@using App05_AuthenticationState.Services
@inject AuthenticationStateService AuthService
@implements IDisposable

<div class="sidebar d-flex flex-column">

    <div class="top-row">
        <a class="navbar-brand" href="">
            🔴 App05
        </a>
    </div>

    <div class="sidebar-brand">
        <div class="app-badge">
            <span>VP</span>
            <span>Lab 04</span>
        </div>
        <h5>Authentication State</h5>
        <p>Service-based Auth Demo</p>
    </div>

    <div class="auth-status-pill @(AuthService.IsAuthenticated ? "logged-in" : "logged-out")">
        <div class="auth-dot @(AuthService.IsAuthenticated ? "online" : "offline")"></div>
        @(AuthService.IsAuthenticated ? "Authenticated" : "Not Logged In")
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="nav flex-column">

            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    🏠 Home
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="login">
                    🔑 Login / Logout
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="user-profile">
                    👤 User Profile
                </NavLink>
            </div>

        </nav>
    </div>

</div>

@code
{
    protected override void OnInitialized()
    {
        AuthService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AuthService.OnChange -= StateHasChanged;
    }
}