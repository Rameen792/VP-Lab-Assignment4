@page "/todo-list"
@rendermode InteractiveServer

<PageTitle>To Do List</PageTitle>

<div class="container mt-5">

    <div class="card shadow border-0">

        <div class="card-header text-white"
             style="background-color:#34495E;">

            <h2 class="mb-0">
                Task Manager
            </h2>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-9">

                    <input class="form-control"
                           placeholder="Enter a task..."
                           @bind="NewTask" />

                </div>

                <div class="col-md-3">

                    <button class="btn w-100 text-white"
                            style="background-color:#2C3E50;"
                            @onclick="AddTask">

                        Add Task

                    </button>

                </div>

            </div>

            <div class="mt-3">

                <button class="btn btn-outline-danger"
                        @onclick="ClearTasks">

                    Clear All Tasks

                </button>

            </div>

            <hr />

            <h5 class="mb-3">
                Current Tasks
            </h5>

            @if (Tasks.Count == 0)
            {
                <div class="alert alert-secondary">

                    No tasks added yet.

                </div>
            }
            else
            {
                <ul class="list-group">

                    @foreach (var task in Tasks)
                    {
                        <li class="list-group-item">

                            @task

                        </li>
                    }

                </ul>
            }

            <div class="card mt-4">

                <div class="card-body">

                    <h5 class="text-primary">
                        Data Binding Usage
                    </h5>

                    <p>
                        <strong>Two-Way Binding:</strong>
                        The task textbox uses
                        <code>@@bind</code>
                        to keep the input synchronized with
                        the NewTask variable.
                    </p>

                    <p>
                        <strong>One-Way Binding:</strong>
                        The task list is displayed using Razor
                        rendering from the Tasks collection.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>

@code
{
    private string NewTask = string.Empty;

    private List<string> Tasks = new();

    private void AddTask()
    {
        if (!string.IsNullOrWhiteSpace(NewTask))
        {
            Tasks.Add(NewTask.Trim());

            NewTask = string.Empty;
        }
    }

    private void ClearTasks()
    {
        Tasks.Clear();
    }
}