@page "/greeting-binding"
@rendermode InteractiveServer

<PageTitle>Greeting Binding</PageTitle>

<div class="container mt-5">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-primary text-white">

            <h2 class="mb-0">
                Greeting Application
            </h2>

        </div>

        <div class="card-body">

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Enter Your Name
                </label>

                <input class="form-control"
                       placeholder="Type your name here..."
                       @bind="UserName" />

            </div>

            <hr />

            @if (!string.IsNullOrWhiteSpace(UserName))
            {
                <div class="alert alert-success">

                    <h4>
                        Hello, @UserName!
                    </h4>

                    <p class="mb-0">
                        Welcome to Blazor Data Binding.
                    </p>

                </div>
            }
            else
            {
                <div class="alert alert-warning">

                    Please enter your name above.

                </div>
            }

            <hr />

            <div class="card mt-3">

                <div class="card-body">

                    <h5 class="text-primary">
                        Data Binding Explanation
                    </h5>

                    <p>
                        <strong>Two-Way Binding:</strong>
                        The textbox uses
                        <code>@@bind</code>
                        to automatically update the
                        UserName variable whenever the user types.
                    </p>

                    <p>
                        <strong>One-Way Binding:</strong>
                        The greeting message displays the current
                        value of UserName using Razor syntax
                        (@@UserName).
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>

@code
{
    // Stores the user's name entered in the textbox.
    private string UserName = string.Empty;
}