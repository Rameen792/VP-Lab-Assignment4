@page "/"

<PageTitle>Home</PageTitle>

<div class="container mt-5">

    <div class="card shadow-lg border-0">

        <div class="card-body text-center p-5">

            <h1 class="display-4 fw-bold text-primary">
                Application 01
            </h1>

            <h2 class="mb-4">
                Greeting Binding
            </h2>

            <p class="lead text-muted">
                Visual Programming Assignment 04
            </p>

            <hr class="my-4" />

            <div class="row mt-4">

                <div class="col-md-4 mb-3">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="text-primary">
                                Objective
                            </h5>

                            <p>
                                Demonstrates the concepts required
                                in this application.
                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="text-success">
                                Technologies
                            </h5>

                            <p>
                                Blazor, Razor Components,
                                Bootstrap and .NET 10.
                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="text-danger">
                                Features
                            </h5>

                            <p>
                                Interactive user interface with
                                modern responsive design.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <div class="alert alert-info mt-4">

                <strong>
                    Student Assignment Project
                </strong>

                <br />

                This application demonstrates the required
                concepts of the Visual Programming Lab.

            </div>

        </div>

    </div>

</div>