@page "/"

<PageTitle>NotifyHub — Home</PageTitle>

<div class="page-hero">
    <div class="hero-tag">✦ Application 06</div>
    <h1 class="page-title">Configurable<br />Notification Service</h1>
    <p class="page-subtitle">
        A fully injectable notification system built with Dependency Injection,
        singleton configuration, and dynamic Compact / Detailed display modes.
    </p>

    <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:1.75rem;">
        <div class="stat-chip">🔔 <span>DI</span> Injected Service</div>
        <div class="stat-chip">⚙️ <span>Singleton</span> Config</div>
        <div class="stat-chip">🎨 <span>2</span> View Styles</div>
    </div>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1.25rem; margin-bottom:2rem;">
    <div class="glass-card">
        <div style="font-size:1.75rem; margin-bottom:0.75rem;">🏗️</div>
        <div style="font-weight:700; margin-bottom:0.4rem; color:var(--text-primary);">NotificationService</div>
        <div style="color:var(--text-secondary); font-size:0.875rem; line-height:1.6;">
            Injected via DI, reads from <code style="color:var(--teal-400)">NotificationConfig</code> to determine default count and style.
        </div>
    </div>
    <div class="glass-card">
        <div style="font-size:1.75rem; margin-bottom:0.75rem;">⚙️</div>
        <div style="font-weight:700; margin-bottom:0.4rem; color:var(--text-primary);">NotificationConfig</div>
        <div style="color:var(--text-secondary); font-size:0.875rem; line-height:1.6;">
            Registered as a <code style="color:var(--teal-400)">Singleton</code>. Changes in Settings persist app-wide.
        </div>
    </div>
    <div class="glass-card">
        <div style="font-size:1.75rem; margin-bottom:0.75rem;">🎨</div>
        <div style="font-weight:700; margin-bottom:0.4rem; color:var(--text-primary);">Dynamic Views</div>
        <div style="color:var(--text-secondary); font-size:0.875rem; line-height:1.6;">
            Toggle between <code style="color:var(--teal-400)">Compact</code> and <code style="color:var(--teal-400)">Detailed</code> view modes in real time.
        </div>
    </div>
</div>

<div style="display:flex; gap:1rem; flex-wrap:wrap;">
    <a href="/notifications" class="btn-teal" style="text-decoration:none; display:inline-flex; align-items:center; gap:0.5rem;">
        🔔 View Notifications
    </a>
    <a href="/settings" class="btn-outline-teal" style="text-decoration:none; display:inline-flex; align-items:center; gap:0.5rem;">
        ⚙️ Configure Settings
    </a>
</div>